{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanexus.invalid/schemas/practice-operation-v1.json",
  "title": "ArcaneXus Practice Protocol Operation",
  "type": "object",
  "required": [
    "schema_version",
    "operation_id",
    "system_id",
    "intent",
    "success_condition",
    "scope",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^ANX-OP-[A-F0-9]{16}$"
    },
    "parent_operation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "system_id": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "success_condition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "failure_condition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "scope": {
      "type": "object",
      "required": [
        "resources",
        "allowed_actions",
        "denied_actions",
        "lease_seconds"
      ],
      "properties": {
        "resources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "denied_actions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "lease_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "DEFINED",
        "BOUNDED",
        "EXECUTED",
        "OBSERVED",
        "VERIFIED",
        "CLASSIFIED",
        "CLOSED"
      ]
    },
    "classification": {
      "enum": [
        "CLOSE",
        "REVISE",
        "REDUCE",
        "ACT",
        "WAIT",
        "REFER"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
